{
  "name": "@favorodera/use-promise",
  "version": "0.0.0",
  "type": "module",
  "description": "A Vue reactive promise wrapper for handling async operations.",
  "license": "MIT",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "homepage": "https://github.com/favorodera/use-promise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/use-promise.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/use-promise/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint . --fix",
